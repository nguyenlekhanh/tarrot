        "endedAt": "2026-11-06T06:02:50.832Z",
        "lines": [
          {
            "speaker": "oracle",
            "text": "If a question has been circling you for days, a reading may give it somewhere to land."
          }
        ]
      },
      {
        "runId": "run_1793944911234_6kpv",
        "conversationId": "ambient_5",
        "category": "ambient",
        "status": "spoken",
