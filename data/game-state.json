        "endedAt": "2026-11-06T06:01:51.235Z",
        "lines": [
          {
            "speaker": "oracle",
            "text": "The smoke curls upward and forgets where it was going. I like that about it."
          }
        ]
      },
      {
        "runId": "run_1793944893477_6qwh",
        "conversationId": "ambient_2",
        "category": "ambient",
        "status": "spoken",
