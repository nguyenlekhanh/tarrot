            "speaker": "oracle",
            "text": "The Hermit carries a lamp, not a torch. Some truths only survive a small light."
          }
        ]
      },
      {
        "runId": "run_1793945016188_5myi",
        "conversationId": "tarot_4",
        "category": "tarot",
        "status": "spoken",
        "startedAt": "2026-11-06T06:03:36.189Z",
        "endedAt": "2026-11-06T06:03:36.189Z",
        "lines": [
          {
            "speaker": "oracle",
            "text": "The Star asks for nothing but your attention. That is why it is so often missed."
          }
        ]
      },
      {
        "runId": "run_1793944970831_44z1",
        "conversationId": "reading_1",
        "category": "reading",
        "status": "spoken",
